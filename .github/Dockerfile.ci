FROM mcr.microsoft.com/devcontainers/python:3.11

# Install system dependencies
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get -y install --no-install-recommends \
    openjdk-21-jdk-headless \
    git \
    curl \
    gpg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set Java environment (Java 21 for Spark 3.5)
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Upgrade pip, wheel, and gitpython before installing uv to resolve known CVEs
# in the versions shipped with the base devcontainer image.
RUN pip install --no-cache-dir --upgrade pip wheel gitpython

# Install uv (dependency manager / build frontend). poe comes from the dev group.
RUN pip install --no-cache-dir uv==0.12.20

# Set working directory
WORKDIR /workspace

# Workflow jobs check out the repo at a different path (/__w/...) and run as
# a different HOME. Pin uv's project environment to the venv baked into this
# image and disable implicit syncing, so `uv run` (which poe's uv executor
# wraps every task in) always uses /workspace/.venv instead of creating and
# syncing a fresh empty .venv next to the checkout (no azure/pytest ->
# system-test preflight failures).
ENV UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    UV_NO_SYNC=1 \
    UV_LINK_MODE=copy

# Copy dependency files first (for better caching)
COPY pyproject.toml uv.lock ./
COPY packages/kindling_cli ./packages/kindling_cli
COPY packages/kindling_sdk ./packages/kindling_sdk

# Install locked dependencies (dev group included) — creates /workspace/.venv.
# The root project itself is not installed here; jobs `pip install -e .` the
# checkout. The cli/sdk workspace members are installed editable from the
# copies above, matching the previous `poetry install --with dev --no-root`.
# uv venvs ship without pip, but workflow steps `pip install` into this venv
# (and pip-audit audits it), so seed pip first and sync --inexact to keep it.
RUN uv venv --seed /workspace/.venv \
    && uv sync --frozen --no-install-project --inexact

# Put the venv on PATH so every subsequent layer and every workflow step
# finds the right python/pip/black/poe without explicit activation.
ENV PATH="/workspace/.venv/bin:${PATH}"

# Default command
CMD ["/bin/bash"]
