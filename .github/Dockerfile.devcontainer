# Kindling developer environment image.
#
# Published to ghcr.io/sep/spark-kindling-framework/devcontainer:latest.
# Repos scaffolded with `kindling repo init` use this as their devcontainer
# base. This image intentionally does NOT install the Kindling framework or
# SDK: those are per-project Poetry dependencies, pinned to a specific
# Kindling release wheel URL in each project's own pyproject.toml/poetry.lock
# (see templates/pyproject.toml.j2). Baking them into the image here would
# mean building from source at whatever commit triggered the image build,
# which only matches a real, fetchable GitHub release when the build runs
# from a release tag -- a workflow_dispatch dev build does not, and the
# resulting version-pinned dependency in every project created afterward
# would silently 404 on `poetry install`.
#
# What's baked in:
#   - Python 3.11 + Java 21 (for PySpark 3.5)
#   - Poetry (for project-level dependency management)
#   - The Kindling CLI only, installed from the latest published GitHub
#     release (never built from source), so `kindling env bootstrap` is
#     always available to add the framework/SDK to a project that doesn't
#     declare them yet -- see postCreateCommand in devcontainer.json.j2.
#   - Hadoop Azure JARs at /opt/hadoop-jars (ABFSS integration tests)
#   - /tmp/hadoop-jars symlink expected by conftest.py fixtures
#   - /spark-warehouse pre-created and owned by vscode

FROM mcr.microsoft.com/devcontainers/python:3.11

# System deps: Java 21 for PySpark 3.5
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get -y install --no-install-recommends \
        openjdk-21-jdk-headless \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Resolve JAVA_HOME dynamically so the image works on both amd64 and arm64.
RUN JAVA_BIN="$(readlink -f "$(command -v java)")" \
    && JAVA_HOME_REAL="$(dirname "$(dirname "$JAVA_BIN")")" \
    && ln -sfn "$JAVA_HOME_REAL" /usr/lib/jvm/java-21-openjdk-current

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-current
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Install Poetry and Poe globally (version-pinned for reproducibility)
RUN pip install --no-cache-dir poetry==1.8.3 poethepoet==0.45.0

# Install only the Kindling CLI (and its spark-kindling-sdk dependency),
# resolved from the latest published GitHub release -- a real, fetchable
# release, unlike a wheel built from whatever source commit triggered this
# image build. The CLI's own version doesn't need to match any project's
# pinned framework version: it's a bootstrap tool, not a runtime dependency
# domain app code imports.
#
# spark-kindling-sdk is fetched alongside it because the CLI wheel's own
# metadata declares a hard `spark-kindling-sdk>=<version>` requirement (a
# plain version constraint, not a URL -- poetry-core bakes the root
# project's path dependency into that form when building a standalone
# wheel), and spark-kindling-sdk has never been published to PyPI. Passing
# both wheels to the same `pip install` lets pip's resolver satisfy that
# requirement from the second URL instead of trying PyPI.
RUN LATEST_RELEASE_JSON="$(curl -fsSL https://api.github.com/repos/sep/spark-kindling-framework/releases/latest)" \
    && LATEST_CLI_WHEEL_URL="$(echo "$LATEST_RELEASE_JSON" \
        | python3 -c "import json, sys; assets = json.load(sys.stdin)['assets']; print(next(a['browser_download_url'] for a in assets if a['name'].startswith('spark_kindling_cli-') and a['name'].endswith('.whl')))")" \
    && LATEST_SDK_WHEEL_URL="$(echo "$LATEST_RELEASE_JSON" \
        | python3 -c "import json, sys; assets = json.load(sys.stdin)['assets']; print(next(a['browser_download_url'] for a in assets if a['name'].startswith('spark_kindling_sdk-') and a['name'].endswith('.whl')))")" \
    && pip install --no-cache-dir "$LATEST_CLI_WHEEL_URL" "$LATEST_SDK_WHEEL_URL"

# Pre-download Hadoop Azure JARs needed for local ABFSS integration tests.
# Stored in /opt/hadoop-jars (stable image layer).
# conftest.py fixtures reference /tmp/hadoop-jars via the symlink below.
RUN mkdir -p /opt/hadoop-jars \
    && curl -fsSL -o /opt/hadoop-jars/hadoop-azure-3.3.4.jar \
        https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-azure/3.3.4/hadoop-azure-3.3.4.jar \
    && curl -fsSL -o /opt/hadoop-jars/hadoop-azure-datalake-3.3.4.jar \
        https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-azure-datalake/3.3.4/hadoop-azure-datalake-3.3.4.jar \
    && curl -fsSL -o /opt/hadoop-jars/azure-storage-8.6.6.jar \
        https://repo1.maven.org/maven2/com/microsoft/azure/azure-storage/8.6.6/azure-storage-8.6.6.jar \
    && curl -fsSL -o /opt/hadoop-jars/wildfly-openssl-1.1.3.Final.jar \
        https://repo1.maven.org/maven2/org/wildfly/openssl/wildfly-openssl/1.1.3.Final/wildfly-openssl-1.1.3.Final.jar \
    && curl -fsSL -o /opt/hadoop-jars/jetty-util-ajax-9.4.51.v20230217.jar \
        https://repo1.maven.org/maven2/org/eclipse/jetty/jetty-util-ajax/9.4.51.v20230217/jetty-util-ajax-9.4.51.v20230217.jar \
    && ln -s /opt/hadoop-jars /tmp/hadoop-jars

RUN mkdir -p /spark-warehouse && chown -R vscode:vscode /spark-warehouse

# ── Agent reference doc ───────────────────────────────────────────────────────
# Baked in at a well-known path so downstream projects can generate
# tool-specific agent instruction files via `kindling agent setup`.
# Also written to ~/.claude/CLAUDE.md so Claude Code picks it up as
# user-level context without any project-level configuration.
COPY .github/kindling-agent-reference.md /opt/kindling/agent-reference.md
RUN mkdir -p /home/vscode/.claude \
       /home/vscode/.vscode-server/data/User/globalStorage \
       /home/vscode/.vscode-server/data/Machine \
    && cp /opt/kindling/agent-reference.md /home/vscode/.claude/CLAUDE.md \
    && chown -R vscode:vscode /home/vscode/.claude /home/vscode/.vscode-server

LABEL org.opencontainers.image.source="https://github.com/sep/spark-kindling-framework"
LABEL org.opencontainers.image.description="Kindling developer environment — Python 3.11, Java 21, Kindling CLI, Hadoop JARs"
