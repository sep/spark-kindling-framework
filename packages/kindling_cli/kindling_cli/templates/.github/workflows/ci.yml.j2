name: CI

on:
  push:
    branches: ["main", "master"]
  pull_request:
  workflow_dispatch:

env:
  REGISTRY: ghcr.io

jobs:
  test:
    runs-on: ubuntu-latest
    # The devcontainer image supplies Java 21 and uv; it is not tied to a
    # Kindling version, so it's referenced by :latest here rather than a
    # release tag that may never have had a matching image published (the
    # image is only rebuilt when its own inputs change, not on every
    # Kindling release). `uv run` syncs each package, resolving Kindling directly
    # from their pinned GitHub release wheel URLs ([tool.uv.sources], uv.lock).
    container:
      image: ghcr.io/sep/spark-kindling-framework/devcontainer:latest
      credentials:
        username: ${{ "{{" }} github.actor {{ "}}" }}
        password: ${{ "{{" }} secrets.GITHUB_TOKEN {{ "}}" }}

    steps:
      - name: Check out code
        uses: actions/checkout@v4

      - name: Test all packages
        shell: bash
        run: |
          set -euo pipefail
          found=0
          for pkg in packages/*; do
            if [ -f "$pkg/pyproject.toml" ]; then
              found=1
              echo "==> Testing $pkg"
              (cd "$pkg" && uv run poe test && uv run poe build)
            fi
          done
          if [ "$found" -eq 0 ]; then
            echo "No scaffolded packages found under packages/."
            exit 1
          fi
