"""Pipe definitions for {{ kebab_name }}.

Each @DataPipes.pipe decorator fires at import time. The CLI/runner
initializes the framework and auto-imports this module (via the app's
lake-reqs.txt declaring this package) before anything else runs -- no
manual import wiring needed in app.py.
"""

from kindling.data_pipes import DataPipes


@DataPipes.pipe(
    pipeid="bronze_to_silver",
    name="Bronze to Silver",
    tags={"layer": "silver"},
    input_entity_ids=["bronze.records"],
    output_entity_id="silver.records",
    output_type="table",
)
def bronze_to_silver(bronze_records):
    """Promote bronze records to the silver layer."""
    from {{ snake_name }}.transforms.quality import clean_records

    return clean_records(bronze_records)
