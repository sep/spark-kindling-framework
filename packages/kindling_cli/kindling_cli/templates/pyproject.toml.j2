[project]
name = "{{ kebab_name }}"
version = "0.1.0"
description = "Kindling data pipeline project — {{ kebab_name }}"
authors = []
requires-python = ">=3.10"
{% if kindling_source == "github" %}
dependencies = [
    "spark-kindling[standalone]",
]
{% else %}
# Kindling packages are pinned to one release (they are versioned together);
# `kindling env update` moves every pin in the repo to a newer release.
dependencies = [
    "spark-kindling[standalone]=={{ kindling_version }}",
]
{% endif %}

[build-system]
requires = ["uv_build>=0.12.5,<0.13.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ snake_name }}"
{% if kindling_source == "github" %}

# Kindling packages are pinned directly to their release wheel on GitHub (the
# repo root pins them this way, and a workspace must pin one package one way).
# `kindling env update` manages these entries -- and moves them to PyPI
# version pins once the release is on PyPI; see its `--help`.
# spark-kindling-sdk must stay listed: spark-kindling-cli depends on it, and
# that transitive requirement only resolves through this URL override.
[tool.uv.sources]
spark-kindling = { url = "https://github.com/sep/spark-kindling-framework/releases/download/v{{ kindling_version }}/spark_kindling-{{ kindling_version }}-py3-none-any.whl" }
spark-kindling-cli = { url = "https://github.com/sep/spark-kindling-framework/releases/download/v{{ kindling_version }}/spark_kindling_cli-{{ kindling_version }}-py3-none-any.whl" }
spark-kindling-sdk = { url = "https://github.com/sep/spark-kindling-framework/releases/download/v{{ kindling_version }}/spark_kindling_sdk-{{ kindling_version }}-py3-none-any.whl" }

[dependency-groups]
dev = [
    "pytest>=7.0.0",
    "pytest-cov>=4.0.0",
    "poethepoet>=0.24.0",
    "spark-kindling-sdk",
    "spark-kindling-cli",
]
{% else %}

[dependency-groups]
dev = [
    "pytest>=7.0.0",
    "pytest-cov>=4.0.0",
    "poethepoet>=0.24.0",
    "spark-kindling-sdk=={{ kindling_version }}",
    "spark-kindling-cli=={{ kindling_version }}",
]
{% endif %}

[tool.poe.tasks]
test-unit = "pytest tests/unit -v"
test-component = "pytest tests/component -v"
{% if integration %}
test-integration = "pytest tests/integration -v"
test-all = { sequence = ["test-unit", "test-component", "test-integration"] }
{% endif %}
test = { sequence = ["test-unit", "test-component"] }
build = "uv build"
update-kindling = "kindling env update"

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
markers = [
    "unit: local Spark unit tests, no ABFSS",
    "component: DI wiring, no ABFSS",
{% if integration %}
    "integration: requires Spark and ABFSS credentials",
    "requires_azure: skipped when Azure credentials are not set",
{% endif %}
]
