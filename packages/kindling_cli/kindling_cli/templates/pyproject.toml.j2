[build-system]
requires = ["poetry-core>=1.0.0"]
build-backend = "poetry.core.masonry.api"

[tool.poetry]
name = "{{ kebab_name }}"
version = "0.1.0"
description = "Kindling data pipeline project — {{ kebab_name }}"
authors = []
packages = [{include = "{{ snake_name }}", from = "src"}]

# Kindling packages are pinned directly to their release wheel on GitHub, so
# the exact version in use is whatever's recorded in poetry.lock — no local
# wheel cache or Poetry source configuration required. `kindling env update`
# and `kindling env add` manage these entries; see their `--help`.
[tool.poetry.dependencies]
python = "^3.10"
spark-kindling = { url = "https://github.com/sep/spark-kindling-framework/releases/download/v{{ kindling_version }}/spark_kindling-{{ kindling_version }}-py3-none-any.whl", extras = ["standalone"] }

[tool.poetry.group.dev.dependencies]
pytest = ">=7.0.0"
pytest-cov = ">=4.0.0"
poethepoet = ">=0.24.0"
spark-kindling-sdk = { url = "https://github.com/sep/spark-kindling-framework/releases/download/v{{ kindling_version }}/spark_kindling_sdk-{{ kindling_version }}-py3-none-any.whl" }
spark-kindling-cli = { url = "https://github.com/sep/spark-kindling-framework/releases/download/v{{ kindling_version }}/spark_kindling_cli-{{ kindling_version }}-py3-none-any.whl" }

[tool.poe.tasks]
test-unit = "pytest tests/unit -v"
test-component = "pytest tests/component -v"
{% if integration %}
test-integration = "pytest tests/integration -v"
test-all = { sequence = ["test-unit", "test-component", "test-integration"] }
{% endif %}
test = { sequence = ["test-unit", "test-component"] }
build = "poetry build"
update-kindling = "kindling env update"

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
markers = [
    "unit: local Spark unit tests, no ABFSS",
    "component: DI wiring, no ABFSS",
{% if integration %}
    "integration: requires Spark and ABFSS credentials",
    "requires_azure: skipped when Azure credentials are not set",
{% endif %}
]
