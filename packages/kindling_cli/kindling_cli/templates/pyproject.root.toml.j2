# Repo root: a uv workspace over the packages in packages/. It is not itself a
# package (nothing here is built or published); it exists so the whole repo
# shares one environment (.venv/) and one lockfile (uv.lock) with every package
# installed editable.
#
# The devcontainer's `kindling env bootstrap` pins Kindling here on first
# create (adopting the release a package already pins, or the latest release
# for an empty repo) and runs `uv sync --all-packages`. The root pins
# spark-kindling[standalone] so the shared environment has local Spark;
# packages declare plain spark-kindling because their wheels are installed on
# managed Spark runtimes, and carry the Spark stack in their `dev` group. Every package must pin
# the same Kindling release as this root; `kindling env update` moves them.
#
# The `-workspace` suffix keeps this name distinct from a package scaffolded
# with the repo's own name: uv requires unique names across workspace members.
[project]
name = "{{ repo_kebab_name }}-workspace"
version = "0.1.0"
requires-python = ">=3.10"
dependencies = []

[tool.uv]
package = false

[tool.uv.workspace]
members = ["packages/*"]
